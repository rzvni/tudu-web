# tudu-web env vars (copy to .env.local for dev, set in Vercel for prod)

# Backend API (existing tudu deploy)
TUDU_API_BASE=https://tudu-beta.vercel.app
TUDU_BEARER_TOKEN=

# TOTP secret for login (base32, 32 chars). Generate fresh per env.
TOTP_SECRET=

# HMAC key for session cookies (hex, 64 chars).
SESSION_SECRET=
